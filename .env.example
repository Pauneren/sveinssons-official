# Legacy contact form (sendEmail server action). Keep until Form Kit cutover.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Public site URL used for SEO metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# Form Kit parallel backend (/api/contact/). Names only — no values in git.
# Production: FORM_PRODUCTION_COMPOSITION=1 (Redis). Local: 0 (memory).
# Unset/invalid fails closed when NODE_ENV=production.
FORM_PRODUCTION_COMPOSITION=
FORM_TOKEN_SECRET=
FORM_IP_HASH_SECRET=
FORM_ALLOWED_ORIGINS=

FORM_SMTP_HOST=
FORM_SMTP_PORT=
FORM_SMTP_USER=
FORM_SMTP_PASS=
FORM_FROM_EMAIL=
FORM_FROM_NAME=
FORM_TO_EMAIL=
FORM_SUBJECT=

REDIS_URL=
FORM_REDIS_NAMESPACE=

# Leave unset or 0. Do not trust X-Forwarded-For / X-Real-IP.
FORM_TRUST_PROXY=
